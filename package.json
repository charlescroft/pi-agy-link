{
  "name": "pi-agy-link",
  "version": "1.5.0",
  "description": "Google Antigravity (agy CLI) provider & multi-account pool extension for Pi Coding Agent and PiCrust.",
  "type": "module",
  "license": "MIT",
  "icon": "./assets/icon.svg",
  "keywords": [
    "pi-package",
    "pi-extension",
    "antigravity",
    "agy",
    "gemini"
  ],
  "main": "./dist/pi-extension.js",
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ]
  },
  "exports": {
    ".": "./dist/pi-extension.js",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.svg",
    "./icon.svg": "./assets/icon.svg"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "undici": "^8.10.0"
  },
  "files": [
    "dist/pi-extension.js",
    "dist/bridge.mjs",
    "dist/mcp-sanitize.mjs",
    "assets/icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-pi.mjs",
    "build:dsh": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --experimental-transform-types --test \"test/**/*.test.ts\"",
    "test:fast": "node scripts/fast-test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "lint:arch": "node scripts/check-architecture.mjs",
    "lint:budget": "node scripts/check-budgets.mjs",
    "test:coverage": "node --experimental-transform-types --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=80 \"test/**/*.test.ts\"",
    "verify": "npm run check && npm run lint:arch && npm run lint:budget && npm run build && npm test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/charlescroft/pi-agy-link.git"
  },
  "bugs": {
    "url": "https://github.com/charlescroft/pi-agy-link/issues"
  },
  "homepage": "https://github.com/charlescroft/pi-agy-link#readme"
}
